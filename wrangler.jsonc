{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neul-concert-view",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "vars": {
    "APP_VERSION": "1.0.0-cf",
    "SYNC_BATCH_SIZE": "36",
    "SOURCE_TIMEOUT_MS": "6500",
    "ARCHIVE_LIMIT": "20"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.15
  }
}
